{
  "name": "ENSy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:backend": ".venv\\Scripts\\python.exe app.py",
    "dev:all": "concurrently -k -r \".venv\\Scripts\\python.exe app.py\" \"vite --host 0.0.0.0\"",
    "preview": ".venv\\Scripts\\python.exe app.py",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": ".venv/Scripts/pytest tests/ -v -m \"not api\"",
    "test:science": ".venv/Scripts/pytest tests/test_coranking.py tests/test_dataset.py tests/test_models.py -v",
    "dataset": ".venv\\Scripts\\python.exe -m ensy.dataset",
    "experiment": ".venv\\Scripts\\python.exe -m ensy.experiment",
    "test:api": ".venv/Scripts/pytest tests/test_api.py -v -m api",
    "docs:pdf": "python docs/build_pdf.py",
    "docs:results": "python docs/update_results.py",
    "docs:figures": "python docs/capture_screenshots.py",
    "docs:claims": "python docs/check_claims.py"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.184.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
